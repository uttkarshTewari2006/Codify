generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String?
  onboarded Boolean   @default(false)
  roadmaps  Roadmap[]
  deadlines Deadline[]
}

model Roadmap {
  id          String   @id @default(cuid())
  title       String
  description String?
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  tasks       Task[]
  deadlines   Deadline[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  duration    String?
  type        String   @default("info") // problem, guide, info, goal
  status      String   @default("todo") // todo, in-progress, completed
  deliverables String? // stored as JSON string array due to sqlite support
  links       String?  // stored as JSON string array due to sqlite support
  roadmapId   String
  roadmap     Roadmap  @relation(fields: [roadmapId], references: [id])
  order       Int      @default(0) // order of task in roadmap
  completedAt DateTime?
  deadlines   Deadline[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Deadline {
  id            String   @id @default(cuid())
  title         String
  description   String?
  targetDate    DateTime
  status        String   @default("pending") // pending, completed, overdue
  type          String   @default("general") // roadmap, task, deliverable, general
  
  roadmapId     String?
  roadmap       Roadmap? @relation(fields: [roadmapId], references: [id])
  
  taskId        String?
  task          Task?    @relation(fields: [taskId], references: [id])
  
  deliverableId Int?     // index of deliverable
  
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
